# ─── SAHAY Environment Variables ─────────────────────────────────────────────
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real secrets.
# This file (.env.example) is safe to commit — it contains no real values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (Phase 2+) ───────────────────────────────────────────────────────
# Public-facing Supabase project URL and publishable key.
# Safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Supabase Service Role (Phase 2+, server-side only) ────────────────────────
# Used for admin/server operations. NEVER expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Authentication (Phase 3) ──────────────────────────────────────────────────
# AUTH_SECRET=                         # Random 32-char secret for JWT signing

# ── Database — Direct Connection (Phase 2, optional) ─────────────────────────
# Only needed if you bypass Supabase client and use Prisma/pg directly.
# DATABASE_URL=

# ── ML / Risk Engine (Phase 6–7) ─────────────────────────────────────────────
# ML_SERVICE_URL=http://localhost:8000
# ML_SERVICE_API_KEY=

# ── Notifications (Phase 8) ───────────────────────────────────────────────────
# SMS_PROVIDER_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
